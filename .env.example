# {{ project_name }} environment variables
# Copy this file to .env and fill in your values

# Application
# LOG_LEVEL=info

# Context7 MCP (optional) — local MCP server runs inside the container.
# The key is only needed for higher rate limits / private repos;
# leave unset to use default rate-limited access.
# CONTEXT7_API_KEY=your_key_here

# Set a GitHub Personal Access Token (PAT) with the
# `repo` scope (create one at https://github.com/settings/tokens). `gh` is used
# as the git credential helper, so `git pull`/`push` authenticate without a
# password prompt. Leave unset to skip in-container git authentication.
# GITHUB_TOKEN=your_token_here
